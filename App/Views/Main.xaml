<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI 선행기술조사 · 평가 관리" Width="1480" Height="940" MinWidth="1100" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Malgun Gothic" FontSize="13" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ControlTemplate x:Key="ContentOnlyTabs" TargetType="TabControl"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border></ControlTemplate>
    <SolidColorBrush x:Key="Accent" Color="#2257C7"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CDD7E5"/><Setter Property="Foreground" Value="#233956"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CDD7E5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="MinWidth" Value="100"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="IsTextSearchEnabled" Value="True"/><Setter Property="MaxDropDownHeight" Value="330"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EDF5"/><Setter Property="BorderBrush" Value="#DDE5F0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="RowHeaderWidth" Value="0"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EFF3F9"/><Setter Property="Foreground" Value="#4B607C"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#DDE5F0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="EvaluationChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="IsEditable" Value="False"/><Setter Property="MinWidth" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="6,3"/><Style.Triggers><DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding notDelivered}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding noResults}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="14,12"/><Setter Property="Foreground" Value="#526580"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#4B607C"/><Setter Property="Padding" Value="0,6"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border Background="#152744" Padding="24,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="AI 선행기술조사 · 평가 관리" FontSize="22" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="IdentityText" Foreground="#BDCCE3" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SwitchUserButton" Content="사용자 변경" Margin="0,0,20,0"/><TextBlock Text="운영월" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="PeriodCombo" Width="140" DisplayMemberPath="period" ToolTip="월을 선택하면 목록이 바로 바뀝니다."/><Button x:Name="RefreshButton" Content="새로 고침" Margin="10,0,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CaseSidebarColumn" Width="340" MinWidth="290" MaxWidth="480"/><ColumnDefinition x:Name="CaseGapColumn" Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="CaseSidebar" Background="White" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="8" Padding="14"><ScrollViewer x:Name="CaseSidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><DockPanel MinHeight="650" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
        <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="CaseListTitleText" Text="내 대상 출원" FontSize="19" FontWeight="SemiBold" Foreground="#233956"/><TextBlock x:Name="CaseListHintText" Text="출원을 선택하면 바로 조회됩니다." Foreground="#718098" FontSize="12" Margin="0,5,0,14"/>
          <ComboBox x:Name="ScopeCombo" DisplayMemberPath="name" Margin="0,0,0,9" ToolTip="조회 범위"/>
          <TextBlock Text="출원번호 · CPC · 이름 검색" Foreground="#718098" FontSize="12" Margin="0,2,0,6"/><TextBox x:Name="SearchBox" ToolTip="출원번호, CPC, 이름, 심사국, 심사과 검색" Margin="0,0,0,9"/>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock x:Name="CaseCountText" Foreground="#718098" VerticalAlignment="Center"/><ComboBox x:Name="CaseStateCombo" Grid.Column="1" SelectedIndex="0" ToolTip="출원 상태 필터"><ComboBoxItem Content="접수된 출원" Tag="Active"/><ComboBoxItem Content="전체 상태" Tag="All"/><ComboBoxItem Content="중복 확인" Tag="Duplicate"/><ComboBoxItem Content="취소된 출원" Tag="Cancelled"/></ComboBox></Grid>
        </StackPanel>
        <Expander x:Name="ExportOptions" DockPanel.Dock="Bottom" Header="엑셀 · 첨부파일 다운로드" Margin="0,12,0,0"><StackPanel Margin="0,9,0,0"><Button x:Name="CaseExportButton" Content="선택 출원 다운로드" Margin="0,0,0,7"/><Button x:Name="ExportButton" Content="이번 달 엑셀 다운로드" Margin="0,0,0,7"/><Button x:Name="ZipButton" Content="이번 달 엑셀 + 첨부 ZIP" Margin="0"/></StackPanel></Expander>
        <Grid MinHeight="250"><DataGrid x:Name="CasesGrid" MinHeight="250" IsReadOnly="True" ToolTip="출원을 한 번 클릭해 조회하세요."><DataGrid.Columns><DataGridTemplateColumn Header="출원번호 / CPC" Width="*" MinWidth="138"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding applicationNumber}"/><TextBlock Text="{Binding cpc}" FontSize="11" Foreground="#718098"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="심사관" Binding="{Binding examinerName}" Width="78"/><DataGridTextColumn Header="상태" Binding="{Binding statusLabel}" Width="90"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding caseHint}"/><Setter Property="Cursor" Value="Hand"/></Style></DataGrid.RowStyle></DataGrid>
          <TextBlock x:Name="CasesEmptyText" Text="표시할 출원이 없습니다.&#10;운영월과 조회 범위를 확인하거나&#10;대상건을 등록하세요." TextAlignment="Center" TextWrapping="Wrap" Foreground="#718098" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
      </DockPanel></ScrollViewer></Border>
      <GridSplitter x:Name="CaseSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition x:Name="CaseHeaderRow" Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="CaseHeaderPanel" Margin="4,0,0,8"><TextBlock x:Name="CaseTitle" Text="대상건을 등록해 시작하세요" FontSize="21" FontWeight="SemiBold" Foreground="#172B4D"/><TextBlock x:Name="CaseMetadataText" Foreground="#2257C7" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CaseSubtitle" Text="내 심사 업무: 1. 대상건 선정 → 2. AI 검색 결과 평가" Foreground="#718098" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="White" BorderBrush="#DDE5F0">
          <TabItem x:Name="PersonalWorkTab" Header="내 심사 업무"><DockPanel>
            <Border DockPanel.Dock="Top" Background="#F1F5FC" Padding="16,11" Margin="12,12,12,0" CornerRadius="5"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=PersonalTabs}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock x:Name="WorkflowHintText" Text="1. 대상건 선정에서 출원을 등록한 뒤, 2. AI 검색 결과 평가에서 납품 결과를 확인하고 평가하세요." Foreground="#4B607C" TextWrapping="Wrap"/></Border>
            <TabControl x:Name="PersonalTabs" BorderThickness="0" Background="White" Margin="12">
          <TabItem x:Name="TargetSelectionTab" Header="1. 대상건 선정"><DockPanel Margin="12">
            <Border DockPanel.Dock="Bottom" Background="#F8FAFD" Padding="16,12" BorderBrush="#DDE5F0" BorderThickness="0,1,0,0"><StackPanel><WrapPanel><Button x:Name="SelectionDraftButton" Content="임시저장"/><Button x:Name="SubmitButton" Style="{StaticResource Primary}" Content="출원 등록"/><Button x:Name="CancelSubmissionButton" Content="선택 출원 취소"/></WrapPanel><ScrollViewer MaxHeight="62" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SubmissionResult" TextWrapping="Wrap" Foreground="#2257C7" Margin="0,8,0,0"/></ScrollViewer></StackPanel></Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
              <TextBlock Text="어떤 출원을 조사할까요?" FontSize="21" FontWeight="SemiBold" Foreground="#233956"/><TextBlock x:Name="SelectionHelpText" Text="출원번호와 CPC를 입력한 뒤 ‘출원 등록’을 누르세요. CPC는 생략할 수 있습니다." Foreground="#718098" Margin="0,8,0,20" TextWrapping="Wrap"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="출원번호" Foreground="#4B607C" Margin="0,0,0,6"/><TextBlock Grid.Column="1" Text="CPC (선택)" Foreground="#4B607C" Margin="10,0,0,6"/>
                <TextBox x:Name="ApplicationNumberBox" Grid.Row="1" ToolTip="예: 10-2026-0000001 · Enter 키로 목록에 추가"/><TextBox x:Name="CpcBox" Grid.Row="1" Grid.Column="1" Margin="10,0" MaxLength="500" ToolTip="예: G06F 16/00 · 여러 분류는 ;로 구분"/><Button x:Name="AddSubmissionRowButton" Grid.Row="1" Grid.Column="2" Content="목록에 추가" Margin="0"/>
              </Grid>
              <Expander Header="엑셀에서 여러 건 붙여넣기" Margin="0,16,0,8"><StackPanel Margin="0,8,0,0"><TextBlock Text="한 줄에 출원번호와 CPC를 탭으로 구분하세요. 출원번호만 붙여넣어도 됩니다." Foreground="#718098" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBox x:Name="SubmissionBox" AcceptsReturn="True" AcceptsTab="True" Height="82" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/><Button x:Name="AddPastedRowsButton" Content="붙여넣기 목록에 추가" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Expander>
              <TextBlock Text="대상건 목록 · 셀을 한 번 클릭해 바로 수정할 수 있습니다." Foreground="#4B607C" Margin="0,8,0,8"/>
              <DataGrid x:Name="SubmissionRowsGrid" Height="250" MinHeight="250"><DataGrid.Columns><DataGridTextColumn Header="출원번호" Binding="{Binding applicationNumber, UpdateSourceTrigger=PropertyChanged}" Width="175"/><DataGridTextColumn Header="CPC" Binding="{Binding cpc, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="처리 결과" Binding="{Binding message}" Width="185" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
              <Button x:Name="RemoveSubmissionRowButton" Content="선택 행 삭제" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <TextBlock Text="임시저장한 목록은 나만 볼 수 있습니다. 확정하면 AI 담당자에게 접수되며 평가 단계가 열립니다." TextWrapping="Wrap" Foreground="#718098" Margin="0,16,0,0"/>
            </StackPanel></ScrollViewer></DockPanel></TabItem>
              <TabItem x:Name="EvaluationTab" Header="2. AI 검색 결과 평가"><TabControl x:Name="EvaluationTabs" BorderThickness="0" Background="White" Margin="12" SelectedIndex="1">
            <TabItem x:Name="EvaluationResultsTab" Header="결과 조회"><DockPanel Margin="12"><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="GoEvaluationButton" Content="이 출원 평가하기" Style="{StaticResource Primary}"/></WrapPanel><ScrollViewer x:Name="PublishedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="400" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="300"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="등록된 검색 결과" FontSize="20" FontWeight="SemiBold" Foreground="#233956"/><TextBlock x:Name="DeliverySummaryText" Text="왼쪽에서 출원을 선택하세요." Foreground="#718098" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
              <DataGrid x:Name="PublishedGrid" Grid.Row="1" MinHeight="300" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="조사 방식" Binding="{Binding sourceName}" Width="145"/><DataGridTextColumn Header="문헌 출원번호" Binding="{Binding identifier}" Width="*"/></DataGrid.Columns></DataGrid>
            </Grid></ScrollViewer></DockPanel></TabItem>
          <TabItem x:Name="EvaluationInputTab" Header="평가 입력"><DockPanel Margin="12">
            <Border DockPanel.Dock="Bottom" BorderBrush="#DDE5F0" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0"><WrapPanel><Button x:Name="SaveEvaluationButton" Content="평가 저장" Style="{StaticResource Primary}"/><TextBlock x:Name="EvaluationSavedText" Foreground="#718098" VerticalAlignment="Center"/></WrapPanel></Border>
            <ScrollViewer x:Name="EvaluationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="620" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="152" MinHeight="152"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="300"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12"><TextBlock Text="조사 방식별 품질 순위" FontSize="19" FontWeight="SemiBold" Foreground="#233956"/><TextBlock x:Name="EvaluationStateText" Text="왼쪽에서 본인 출원을 선택하면 바로 평가할 수 있습니다." Foreground="#718098" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
            <DataGrid x:Name="RankGrid" Grid.Row="1" MinHeight="152" RowHeight="36" ColumnHeaderHeight="32"><DataGrid.Columns><DataGridTextColumn Header="조사 방식" Binding="{Binding sourceName}" Width="*" IsReadOnly="True"/><DataGridTemplateColumn Header="순위 / 상태" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource EvaluationChoice}" SelectedValuePath="Tag" SelectedValue="{Binding choice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="순위 또는 평가 상태 선택"><ComboBoxItem Content="선택 안 함" Tag=""/><ComboBoxItem Content="대기 중" Tag="대기 중"/><ComboBoxItem Content="1위" Tag="1"/><ComboBoxItem Content="2위" Tag="2"/><ComboBoxItem Content="3위" Tag="3"/><ComboBoxItem Content="순위 외" Tag="순위 외"/><ComboBoxItem Content="평가 제외" Tag="평가 제외"/><ComboBoxItem Content="비교 불가" Tag="비교 불가"/></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="2" Margin="0,16,0,10"><TextBlock Text="문헌별 평가" FontSize="19" FontWeight="SemiBold" Foreground="#233956"/><TextBlock Text="점수·인용 여부는 목록에서 선택하세요. ‘미평가’와 0점·X는 구분됩니다." Foreground="#718098" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
            <DataGrid x:Name="RatingsGrid" Grid.Row="3" MinHeight="300"><DataGrid.Columns><DataGridTextColumn Header="조사 방식" Binding="{Binding sourceName}" Width="105" IsReadOnly="True"/><DataGridTextColumn Header="문헌" Binding="{Binding identifier}" Width="160" IsReadOnly="True"/>
              <DataGridTemplateColumn Header="점수(0~5점)" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource EvaluationChoice}" SelectedValuePath="Tag" SelectedValue="{Binding scoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="문헌 점수 선택"><ComboBoxItem Content="미평가" Tag=""/><ComboBoxItem Content="0점" Tag="0"/><ComboBoxItem Content="1점" Tag="1"/><ComboBoxItem Content="2점" Tag="2"/><ComboBoxItem Content="3점" Tag="3"/><ComboBoxItem Content="4점" Tag="4"/><ComboBoxItem Content="5점" Tag="5"/></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="인용여부(O/X)" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource EvaluationChoice}" SelectedValuePath="Tag" SelectedValue="{Binding citedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="인용 여부 선택"><ComboBoxItem Content="미평가" Tag=""/><ComboBoxItem Content="O (인용)" Tag="O"/><ComboBoxItem Content="X (미인용)" Tag="X"/></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="비고" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="130"/></DataGrid.Columns></DataGrid>
          </Grid></ScrollViewer></DockPanel></TabItem>
              </TabControl></TabItem>
            </TabControl>
          </DockPanel></TabItem>
          <TabItem x:Name="DeliveryTab" Header="AI 담당 업무"><DockPanel Margin="20"><Border DockPanel.Dock="Bottom" BorderBrush="#DDE5F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><WrapPanel><Button x:Name="PublishButton" Content="AI 검색 결과 저장" Style="{StaticResource Primary}"/><Button x:Name="DraftButton" Content="임시저장"/><TextBlock x:Name="DocumentCountText" Foreground="#718098" VerticalAlignment="Center" Margin="8,0,0,0"/></WrapPanel></Border><ScrollViewer x:Name="DeliveryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="600" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="250"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16"><TextBlock Text="AI 검색 결과 입력" FontSize="21" FontWeight="SemiBold" Foreground="#233956"/><TextBlock Text="담당 그룹의 출원을 선택해 배정된 AI 검색 결과를 입력하세요. 본인 출원 선정과 평가는 ‘내 심사 업무’에서 진행합니다." Foreground="#718098" Margin="0,7,0,16" TextWrapping="Wrap"/><TextBlock Text="조사 방식 선택" Foreground="#4B607C" Margin="0,0,0,7"/><WrapPanel><ComboBox x:Name="SourceCombo" Width="200" DisplayMemberPath="name" ToolTip="선택하면 저장된 결과를 바로 불러옵니다."/><Button x:Name="LoadDeliveryButton" Content="최신 결과 새로 고침" Margin="10,0,8,0"/><TextBlock x:Name="DeliveryStateText" VerticalAlignment="Center" Foreground="#718098"/></WrapPanel></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="찾은 문헌의 출원번호를 입력하세요 · 한 줄에 하나씩, 최대 7건" Foreground="#4B607C" Margin="0,0,0,8" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ResultNumbersBox" AcceptsReturn="True" Height="72" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="여러 문헌번호를 붙여넣고 바로 등록해도 목록에 자동 반영됩니다."/><Button x:Name="AddResultNumbersButton" Grid.Column="1" Content="목록에 추가" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid></StackPanel>
            <DataGrid x:Name="DocumentsGrid" Grid.Row="2" MinHeight="250"><DataGrid.Columns><DataGridTextColumn Header="문헌 출원번호 · 클릭하여 수정" Binding="{Binding identifier, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel><Button x:Name="AddDocumentButton" Content="빈 행 추가"/><Button x:Name="RemoveDocumentButton" Content="선택 삭제"/></WrapPanel>
            </StackPanel>
          </Grid></ScrollViewer></DockPanel></TabItem>
          <TabItem x:Name="StatisticsTab" Header="통계·현황"><ContentControl x:Name="StatisticsHost"/></TabItem>
          <TabItem x:Name="AdminTab" Header="운영 관리"><ContentControl x:Name="AdminContentHost"/></TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#DDE5F0" BorderThickness="0,1,0,0" Padding="20,8"><DockPanel><TextBlock x:Name="ModeText" DockPanel.Dock="Right" Foreground="#718098"/><TextBlock x:Name="StatusText" Text="자료를 불러오는 중…" Foreground="#334A6B" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
</Window>
