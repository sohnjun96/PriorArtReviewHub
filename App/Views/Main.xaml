<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI 선행기술조사 · 평가 관리" Width="1380" Height="900" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Malgun Gothic" FontSize="13" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2257C7"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD5E2"/><Setter Property="Foreground" Value="#22304A"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CCD5E2"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinWidth" Value="115"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8ECF3"/><Setter Property="BorderBrush" Value="#E0E6EF"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="37"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="17,10"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border Background="#152744" Padding="26,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="AI 선행기술조사 · 평가 관리" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="IdentityText" Foreground="#B8C9E6" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="운영월" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="PeriodCombo" Width="130" DisplayMemberPath="period"/><Button x:Name="RefreshButton" Content="새로 고침" Margin="12,0,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="8" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"><TextBlock Text="출원 목록" FontSize="19" FontWeight="SemiBold"/><ComboBox x:Name="ScopeCombo" Margin="0,14,0,10" DisplayMemberPath="name"/><TextBlock Text="출원번호·CPC·이름·소속 검색" Foreground="#63738A" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" ToolTip="출원번호, CPC, 심사관, 심사국, 심사과로 검색" Margin="0,0,0,10"/><TextBlock x:Name="CaseCountText" Foreground="#63738A" Margin="0,0,0,10"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="CaseExportButton" Content="선택 출원 엑셀·첨부 다운로드" Margin="0,0,0,7"/><Button x:Name="ExportButton" Content="월별 목록·평가 엑셀 다운로드" Margin="0,0,0,7"/><Button x:Name="ZipButton" Content="월별 엑셀 + 첨부 ZIP 다운로드" Margin="0"/></StackPanel>
          <DataGrid x:Name="CasesGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="출원번호" Binding="{Binding applicationNumber}" Width="*"/><DataGridTextColumn Header="CPC" Binding="{Binding cpc}" Width="95"/><DataGridTextColumn Header="심사관" Binding="{Binding examinerName}" Width="70"/><DataGridTextColumn Header="상태" Binding="{Binding statusLabel}" Width="65"/></DataGrid.Columns></DataGrid>
        </DockPanel>
      </Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="CaseTitle" Text="출원을 등록하거나 목록에서 선택하세요" FontSize="23" FontWeight="SemiBold" Foreground="#172B4D"/><TextBlock x:Name="CaseMetadataText" Foreground="#2257C7" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CaseSubtitle" Text="제출 → 조사 방식별 납품 → 문헌 평가 및 품질 순위" Foreground="#64748B" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="White" BorderBrush="#E0E6EF">
          <TabItem Header="내 제출"><DockPanel>
            <Border DockPanel.Dock="Bottom" Background="#F8FAFD" Padding="20,12" BorderBrush="#E0E6EF" BorderThickness="0,1,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Button x:Name="SubmitButton" Style="{StaticResource Primary}" Content="출원 등록"/><Button x:Name="CancelSubmissionButton" Content="선택 출원 취소"/></StackPanel><ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SubmissionResult" TextWrapping="Wrap" Foreground="#2257C7" Margin="0,8,0,0"/></ScrollViewer></StackPanel></Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
            <TextBlock Text="월별 출원 등록" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="출원번호와 CPC를 입력하세요. CPC는 공란으로 둘 수 있습니다." Foreground="#63738A" Margin="0,8,0,14" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="출원번호" Foreground="#63738A" Margin="0,0,0,6"/><TextBlock Grid.Column="1" Text="CPC" Foreground="#63738A" Margin="10,0,0,6"/>
              <TextBox x:Name="ApplicationNumberBox" Grid.Row="1" ToolTip="예: 10-2026-0000001"/><TextBox x:Name="CpcBox" Grid.Row="1" Grid.Column="1" Margin="10,0" MaxLength="500" ToolTip="예: G06F 16/00 · 여러 분류는 ;로 구분"/><Button x:Name="AddSubmissionRowButton" Grid.Row="1" Grid.Column="2" Content="목록에 추가" Margin="0"/>
            </Grid>
            <DataGrid x:Name="SubmissionRowsGrid" Margin="0,14,0,8" Height="180"><DataGrid.Columns><DataGridTextColumn Header="출원번호" Binding="{Binding applicationNumber, UpdateSourceTrigger=PropertyChanged}" Width="170"/><DataGridTextColumn Header="CPC" Binding="{Binding cpc, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="처리 결과" Binding="{Binding message}" Width="190" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
            <Button x:Name="RemoveSubmissionRowButton" Content="선택 행 삭제" HorizontalAlignment="Left"/>
            <TextBlock Text="여러 건 붙여넣기 · 한 줄에 출원번호와 CPC를 탭으로 구분 (출원번호만 입력해도 됩니다)" Foreground="#63738A" TextWrapping="Wrap" Margin="0,16,0,7"/><TextBox x:Name="SubmissionBox" AcceptsReturn="True" AcceptsTab="True" Height="76" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/><Button x:Name="AddPastedRowsButton" Content="붙여넣기 목록에 반영" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <TextBlock Text="등록에 실패한 행은 목록에 남습니다. 출원번호를 정정할 때는 기존 건을 취소하고 다시 등록하세요." TextWrapping="Wrap" Foreground="#63738A" Margin="0,15,0,0"/>
          </StackPanel></ScrollViewer></DockPanel></TabItem>
          <TabItem Header="납품 조회"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="DeliverySummaryText" Text="출원을 선택하면 공개된 납품자료가 표시됩니다." Foreground="#63738A" Margin="0,0,0,12" TextWrapping="Wrap"/><DataGrid x:Name="PublishedGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="조사 방식" Binding="{Binding sourceName}" Width="100"/><DataGridTextColumn Header="판" Binding="{Binding version}" Width="40"/><DataGridTextColumn Header="유형" Binding="{Binding type}" Width="60"/><DataGridTextColumn Header="문헌 식별정보" Binding="{Binding identifier}" Width="150"/><DataGridTextColumn Header="명칭" Binding="{Binding title}" Width="*"/><DataGridTextColumn Header="관련 설명" Binding="{Binding description}" Width="150"/></DataGrid.Columns></DataGrid></Grid></TabItem>
          <TabItem x:Name="DeliveryTab" Header="결과 입력"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><ComboBox x:Name="SourceCombo" Width="180" DisplayMemberPath="name"/><Button x:Name="LoadDeliveryButton" Content="편집 자료 불러오기" Margin="10,0,8,0"/><TextBlock x:Name="EditVersionText" VerticalAlignment="Center" Foreground="#63738A"/></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><CheckBox x:Name="NoResultsCheck" Content="검색 완료 · 결과 없음" VerticalAlignment="Center" Margin="0,0,15,0"/><TextBox x:Name="NoResultsReasonBox" Width="330" ToolTip="결과 없음 사유"/></StackPanel><TextBlock Text="조사 방식별 최대 7건 · 문헌을 선택한 뒤 첨부파일을 추가할 수 있습니다." Foreground="#63738A" Margin="0,10,0,0"/></StackPanel>
            <DataGrid x:Name="DocumentsGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="유형" Binding="{Binding type, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="문헌 식별정보" Binding="{Binding identifier, UpdateSourceTrigger=PropertyChanged}" Width="150"/><DataGridTextColumn Header="명칭" Binding="{Binding title, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="관련 설명" Binding="{Binding description, UpdateSourceTrigger=PropertyChanged}" Width="150"/><DataGridTextColumn Header="첨부" Binding="{Binding attachmentCount}" Width="45" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="3" Margin="0,13,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="AddDocumentButton" Content="문헌 추가"/><Button x:Name="RemoveDocumentButton" Content="선택 삭제"/><Button x:Name="AttachButton" Content="파일 첨부"/><Button x:Name="HistoryButton" Content="버전 이력"/></StackPanel><TextBlock Text="수정 사유 (재납품 시 필수)" Foreground="#63738A" Margin="0,12,0,5"/><TextBox x:Name="DeliveryReasonBox" Margin="0,0,0,12" ToolTip="수정 사유"/><StackPanel Orientation="Horizontal"><Button x:Name="DraftButton" Content="임시저장"/><Button x:Name="PublishButton" Content="심사관에게 납품" Style="{StaticResource Primary}"/></StackPanel></StackPanel>
          </Grid></TabItem>
          <TabItem Header="내 평가"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="EvaluationStateText" Text="본인 출원에서 평가를 입력할 수 있습니다." Foreground="#63738A" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <DataGrid x:Name="RankGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="조사 방식" Binding="{Binding sourceName}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="납품 판" Binding="{Binding deliveryVersion}" Width="80" IsReadOnly="True"/><DataGridTextColumn Header="순위 / 상태" Binding="{Binding choice, UpdateSourceTrigger=PropertyChanged}" Width="180"/></DataGrid.Columns></DataGrid>
            <TextBlock Grid.Row="2" Text="순위: 1 / 2 / 3 / 순위 외 / 평가 제외 / 비교 불가   ·   점수: 0~5   ·   인용: O 또는 X (공란은 미평가)" Foreground="#63738A" Margin="0,14,0,12" TextWrapping="Wrap"/>
            <DataGrid x:Name="RatingsGrid" Grid.Row="3"><DataGrid.Columns><DataGridTextColumn Header="조사 방식" Binding="{Binding sourceName}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="문헌" Binding="{Binding identifier}" Width="160" IsReadOnly="True"/><DataGridTextColumn Header="명칭" Binding="{Binding title}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="점수" Binding="{Binding scoreText, UpdateSourceTrigger=PropertyChanged}" Width="45"/><DataGridTextColumn Header="O/X" Binding="{Binding citedText, UpdateSourceTrigger=PropertyChanged}" Width="45"/><DataGridTextColumn Header="비고" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged}" Width="150"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="4" Margin="0,13,0,0"><TextBlock Text="평가 수정 사유" Foreground="#63738A" Margin="0,0,0,5"/><TextBox x:Name="EvaluationReasonBox" ToolTip="평가 수정 사유" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="SaveEvaluationButton" Content="평가 저장" Style="{StaticResource Primary}"/><TextBlock x:Name="EvaluationVersionText" Foreground="#63738A" VerticalAlignment="Center"/></StackPanel></StackPanel>
          </Grid></TabItem>
          <TabItem x:Name="AdminTab" Header="운영 관리"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="월별 운영 및 기준정보" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="PeriodStateText" Foreground="#63738A" Margin="0,12,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="ClosePeriodButton" Content="월 마감"/><Button x:Name="ReopenPeriodButton" Content="재개방"/></StackPanel><TextBox x:Name="AdminReasonBox" ToolTip="마감·재개방·기준정보 수정 사유" Margin="0,12,0,16"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="AdminKindCombo" Width="115"><ComboBoxItem Content="사용자" Tag="Users"/><ComboBoxItem Content="그룹" Tag="Groups"/><ComboBoxItem Content="조사 방식" Tag="Sources"/><ComboBoxItem Content="월 운영" Tag="Period"/></ComboBox><TextBox x:Name="AdminIdBox" Width="145" Margin="10,0" ToolTip="사용자·그룹·조사 방식 ID 또는 YYYY-MM"/><Button x:Name="AdminLoadButton" Content="불러오기"/><Button x:Name="AdminSaveButton" Content="설정 저장" Style="{StaticResource Primary}"/></StackPanel><TextBlock Text="ID를 입력하고 불러오세요. 사용자 정보는 아래 폼에서, 다른 기준정보는 JSON으로 편집합니다." Foreground="#63738A" TextWrapping="Wrap" Margin="0,12,0,12"/></StackPanel>
            <TextBox x:Name="AdminJsonBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            <ScrollViewer x:Name="UserFieldsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F8FAFD" Padding="15" Visibility="Collapsed" IsEnabled="False"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="성명" Foreground="#63738A" Margin="0,0,0,6"/><TextBox x:Name="UserNameBox" Grid.Row="1" MaxLength="100"/>
                <TextBlock Grid.Column="1" Text="Windows 계정 SID" Foreground="#63738A" Margin="15,0,0,6"/><TextBox x:Name="UserSidBox" Grid.Row="1" Grid.Column="1" Margin="15,0,0,0" ToolTip="사용자 PC에서 whoami /user로 확인"/>
                <TextBlock Grid.Row="2" Text="심사국" Foreground="#63738A" Margin="0,15,0,6"/><TextBlock Grid.Row="2" Grid.Column="1" Text="심사과" Foreground="#63738A" Margin="15,15,0,6"/>
                <TextBox x:Name="UserBureauBox" Grid.Row="3" MaxLength="100"/><TextBox x:Name="UserDivisionBox" Grid.Row="3" Grid.Column="1" Margin="15,0,0,0" MaxLength="100"/>
              </Grid>
              <TextBlock Text="역할 (중복 선택 가능)" Foreground="#63738A" Margin="0,18,0,10"/><WrapPanel><CheckBox x:Name="UserExaminerCheck" Content="심사관" Margin="0,0,22,10"/><CheckBox x:Name="UserAiCheck" Content="AI 담당자" Margin="0,0,22,10"/><CheckBox x:Name="UserAdminCheck" Content="총괄관리자" Margin="0,0,0,10"/></WrapPanel><CheckBox x:Name="UserActiveCheck" Content="활성 사용자" Margin="0,8,0,12"/>
              <TextBlock Text="심사국·심사과는 공란으로 둘 수 있습니다. 저장한 뒤 월 운영에서 참여 그룹과 담당 AI를 배정하세요." Foreground="#63738A" TextWrapping="Wrap" LineHeight="23"/>
            </StackPanel></ScrollViewer>
          </Grid></TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#E0E6EF" BorderThickness="0,1,0,0" Padding="22,8"><DockPanel><TextBlock x:Name="ModeText" DockPanel.Dock="Right" Foreground="#63738A"/><TextBlock x:Name="StatusText" Text="준비 중…" Foreground="#334A6B"/></DockPanel></Border>
  </Grid>
</Window>
