<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White" FontFamily="Malgun Gothic">
  <UserControl.Resources>
    <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="#F1F5FC"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#52647C"/></Style>
    <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#172B4D"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    <Style x:Key="StatsGrid" TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EDF5"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#DDE5F0"/><Setter Property="MinHeight" Value="300"/><Setter Property="Height" Value="330"/><Setter Property="ColumnHeaderHeight" Value="38"/></Style>
  </UserControl.Resources>
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="StatsScopeText" FontSize="16" FontWeight="SemiBold" Foreground="#172B4D" Margin="0,0,0,10" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,0,0,10">
        <TextBlock Text="그룹" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="StatsGroupCombo" Width="220" DisplayMemberPath="name" SelectedValuePath="groupId" Margin="0,0,14,0"/>
        <TextBlock Text="계정" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="StatsUserCombo" Width="250" DisplayMemberPath="label" SelectedValuePath="userId" Margin="0,0,14,0"/>
        <Button x:Name="StatsResetButton" Content="전체 보기"/>
      </WrapPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDE5F0" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
      <DockPanel><Button x:Name="StatsExportButton" Content="현재 통계 엑셀 다운로드" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock x:Name="StatsUpdatedText" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
    </Border>
    <ScrollViewer x:Name="StatsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <UniformGrid Columns="4" Margin="0,0,0,12">
          <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="참여 심사관 / 미선정" Style="{StaticResource MetricLabel}" TextWrapping="Wrap"/><TextBlock x:Name="StatsParticipantsText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel></Border>
          <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="확정 출원" Style="{StaticResource MetricLabel}" TextWrapping="Wrap"/><TextBlock x:Name="StatsCasesText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel></Border>
          <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="AI 결과 입력 완료 / 전체" Style="{StaticResource MetricLabel}" TextWrapping="Wrap"/><TextBlock x:Name="StatsDeliveriesText" Style="{StaticResource MetricValue}" Text="—"/><TextBlock x:Name="StatsDeliveryRateText" Style="{StaticResource MetricLabel}" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Style="{StaticResource MetricCard}" Margin="0"><StackPanel><TextBlock Text="평가 완료 / 전체" Style="{StaticResource MetricLabel}" TextWrapping="Wrap"/><TextBlock x:Name="StatsEvaluationsText" Style="{StaticResource MetricValue}" Text="—"/><TextBlock x:Name="StatsEvaluationRateText" Style="{StaticResource MetricLabel}" TextWrapping="Wrap"/></StackPanel></Border>
        </UniformGrid>
        <Border Background="#FFF8E8" Padding="12" CornerRadius="5" Margin="0,0,0,12"><TextBlock x:Name="StatsPendingText" Foreground="#805B15" TextWrapping="Wrap"/></Border>
        <TextBlock x:Name="StatsAccountText" Foreground="#52647C" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TabControl x:Name="StatsDetailTabs" BorderBrush="#DDE5F0">
          <TabItem Header="그룹별 통계"><StackPanel Margin="12"><TextBlock Text="그룹을 클릭하면 해당 그룹의 계정별 현황으로 이동합니다." Foreground="#64748B" Margin="0,0,0,10"/>
            <DataGrid x:Name="StatsGroupsGrid" Style="{StaticResource StatsGrid}"><DataGrid.Columns>
              <DataGridTextColumn Header="그룹" Binding="{Binding groupName}" Width="*" MinWidth="130"/>
              <DataGridTextColumn Header="참여" Binding="{Binding participantCount}" Width="65"/><DataGridTextColumn Header="미선정" Binding="{Binding unselectedCount}" Width="75"/>
              <DataGridTextColumn Header="출원" Binding="{Binding caseCount}" Width="65"/><DataGridTextColumn Header="결과 입력 완료" Binding="{Binding deliveredCount}" Width="120"/>
              <DataGridTextColumn Header="입력 대기" Binding="{Binding waitingCount}" Width="90"/><DataGridTextColumn Header="평가 완료" Binding="{Binding completeCount}" Width="90"/>
              <DataGridTextColumn Header="평가 중" Binding="{Binding partialCount}" Width="80"/><DataGridTextColumn Header="미평가" Binding="{Binding unreviewedCount}" Width="75"/>
              <DataGridTextColumn Header="재확인" Binding="{Binding staleCount}" Width="75"/><DataGridTextColumn Header="평가 완료율" Binding="{Binding evaluationRate}" Width="105"/>
            </DataGrid.Columns></DataGrid>
          </StackPanel></TabItem>
          <TabItem Header="계정별 현황"><StackPanel Margin="12"><TextBlock Text="계정을 클릭하면 본인 출원 목록을 표시합니다. 담당 결과 입력은 AI 담당 업무의 완료 / 대상 건수입니다." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DataGrid x:Name="StatsAccountsGrid" Style="{StaticResource StatsGrid}"><DataGrid.Columns>
              <DataGridTextColumn Header="심사과" Binding="{Binding division}" Width="125"/><DataGridTextColumn Header="이름" Binding="{Binding name}" Width="125"/>
              <DataGridTextColumn Header="계정" Binding="{Binding activeLabel}" Width="70"/><DataGridTextColumn Header="대상 건 선정" Binding="{Binding selectionStatus}" Width="105"/>
              <DataGridTextColumn Header="본인 출원" Binding="{Binding caseCount}" Width="90"/><DataGridTextColumn Header="입력 대기" Binding="{Binding waitingCount}" Width="90"/>
              <DataGridTextColumn Header="평가 완료" Binding="{Binding completeCount}" Width="90"/><DataGridTextColumn Header="평가 남음" Binding="{Binding pendingCount}" Width="90"/>
              <DataGridTextColumn Header="재확인" Binding="{Binding staleCount}" Width="75"/><DataGridTextColumn Header="담당 결과 입력" Binding="{Binding aiWork}" Width="130"/>
              <DataGridTextColumn Header="그룹" Binding="{Binding groupName}" Width="150"/><DataGridTextColumn Header="역할" Binding="{Binding roles}" Width="150"/>
            </DataGrid.Columns></DataGrid>
          </StackPanel></TabItem>
          <TabItem Header="출원별 현황"><StackPanel Margin="12"><TextBlock Text="선택한 그룹·계정의 확정 출원입니다. 취소된 출원과 선정 초안은 포함하지 않습니다." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DataGrid x:Name="StatsCasesGrid" Style="{StaticResource StatsGrid}"><DataGrid.Columns>
              <DataGridTextColumn Header="출원번호" Binding="{Binding applicationNumber}" Width="160"/><DataGridTextColumn Header="CPC" Binding="{Binding cpc}" Width="130"/>
              <DataGridTextColumn Header="심사관" Binding="{Binding examiner}" Width="125"/><DataGridTextColumn Header="그룹" Binding="{Binding groupName}" Width="130"/>
              <DataGridTextColumn Header="AI 결과 입력" Binding="{Binding deliveryStatus}" Width="110"/><DataGridTextColumn Header="입력된 방식" Binding="{Binding aiProgress}" Width="90"/>
              <DataGridTextColumn Header="평가" Binding="{Binding evaluationStatus}" Width="120"/><DataGridTextColumn Header="문헌 수" Binding="{Binding documentCount}" Width="80"/>
            </DataGrid.Columns></DataGrid>
          </StackPanel></TabItem>
          <TabItem Header="조사 방식별 통계"><StackPanel Margin="12"><TextBlock Text="최신 검색 결과와 일치하는 평가만 집계합니다. 평균은 점수 입력 문헌, 인용률은 O/X 선택 문헌을 분모로 합니다. 재확인 필요 건의 순위는 제외합니다." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DataGrid x:Name="StatsSourcesGrid" Style="{StaticResource StatsGrid}"><DataGrid.Columns>
              <DataGridTextColumn Header="조사 방식" Binding="{Binding sourceName}" Width="*" MinWidth="140"/><DataGridTextColumn Header="평가 범위" Binding="{Binding assessmentScope}" Width="115"/><DataGridTextColumn Header="입력 대상" Binding="{Binding expectedCount}" Width="80"/>
              <DataGridTextColumn Header="입력 완료" Binding="{Binding publishedCount}" Width="90"/><DataGridTextColumn Header="입력 대기" Binding="{Binding pendingCount}" Width="90"/>
              <DataGridTextColumn Header="문헌" Binding="{Binding documentCount}" Width="65"/><DataGridTextColumn Header="점수 입력" Binding="{Binding scoreCount}" Width="90"/>
              <DataGridTextColumn Header="평균 점수" Binding="{Binding averageScore}" Width="90"/><DataGridTextColumn Header="인용 O" Binding="{Binding citedCount}" Width="75"/>
              <DataGridTextColumn Header="O/X 입력" Binding="{Binding citationCount}" Width="90"/><DataGridTextColumn Header="인용률" Binding="{Binding citationRate}" Width="80"/>
              <DataGridTextColumn Header="1위 횟수" Binding="{Binding firstCount}" Width="90"/>
            </DataGrid.Columns></DataGrid>
          </StackPanel></TabItem>
          <TabItem Header="AI 검색 결과 평가"><StackPanel Margin="12">
            <TextBlock Text="AI 검색 결과 문헌별 평가입니다. AI 담당자는 해당 결과를 등록한 사람이며, —는 미입력입니다. 검색 결과가 바뀐 문헌은 재확인 후 점수·인용여부가 표시됩니다." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatsRatingsCountText" Foreground="#52647C" Margin="0,0,0,10" Text="조회된 AI 검색 결과가 없습니다."/>
            <DataGrid x:Name="StatsRatingsGrid" Style="{StaticResource StatsGrid}" MinHeight="360" Height="420"><DataGrid.Columns>
              <DataGridTextColumn Header="출원번호" Binding="{Binding applicationNumber}" Width="160" MinWidth="160"/>
              <DataGridTextColumn Header="담당 심사관" Binding="{Binding examiner}" Width="105" MinWidth="105"/>
              <DataGridTextColumn Header="AI 담당자" Binding="{Binding aiAuthor}" Width="105" MinWidth="105"/>
              <DataGridTextColumn Header="조사 방식" Binding="{Binding sourceName}" Width="90" MinWidth="90"/>
              <DataGridTextColumn Header="AI 검색 결과" Binding="{Binding identifier}" Width="*" MinWidth="180"/>
              <DataGridTextColumn Header="인용여부" Binding="{Binding citedText}" Width="85" MinWidth="85"/>
              <DataGridTextColumn Header="점수(0~5점)" Binding="{Binding score, TargetNullValue=—}" Width="105" MinWidth="105"/>
              <DataGridTextColumn Header="평가 상태" Binding="{Binding evaluationStatus}" Width="105" MinWidth="105"/>
            </DataGrid.Columns></DataGrid>
          </StackPanel></TabItem>
        </TabControl>
        <TextBlock Text="미선정에는 임시저장 중인 참여자도 포함됩니다. AI 결과 입력 완료는 해당 월 AI 검색 결과가 모두 입력된 출원이며, 평가 완료는 AI 문헌 평가와 선행기술조사를 포함한 품질 순위가 완료된 출원입니다. 선행기술조사 결과 입력은 필요하지 않습니다." Foreground="#64748B" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
